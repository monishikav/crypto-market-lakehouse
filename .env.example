# Copy to .env (never commit .env). Values here are safe defaults for local mode.

# Where the lakehouse lives: "local" (./data folder) or "s3" (your bucket).
STORAGE_MODE=local
DATA_DIR=data

# AWS (used from Phase 1 upload / Phase 3 Glue+Athena). Leave blank while in local mode.
AWS_REGION=ap-south-1
AWS_PROFILE=
S3_BUCKET=

# Kafka: from Windows use localhost:9092. Containers override this to kafka:19092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Optional free CoinGecko "Demo" key (raises rate limits). Works without one too.
COINGECKO_API_KEY=

# Spark (inside Docker)
SPARK_DRIVER_MEMORY=3g
